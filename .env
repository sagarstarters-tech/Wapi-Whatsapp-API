# Application Configuration
APP_NAME=WAPI
APP_VERSION=1.0.0
APP_URL=http://localhost/wapi
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_NAME=wapi_saas
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session & Security
SESSION_NAME=WAPI_SESSION
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
JWT_SECRET=your-jwt-secret-key-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-long!!
WEBHOOK_VERIFY_TOKEN=wapi_webhook_verify_token_2026

# File Upload
MAX_UPLOAD_SIZE=10485760 # 10MB in bytes

# Pagination
ITEMS_PER_PAGE=20

# Timezone
TIMEZONE=Asia/Kolkata
